# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

def setup_signing()
    setup_ci
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: latest_testflight_build_number + 1
    )
    match(type: 'appstore', readonly: true)

    # we need to manually set the profiles and disable automatic signing to use the files from fastlane match
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: "Runner",
      profile_name: "match AppStore im.fluffychat.app",
      code_sign_identity: "Apple Distribution",
      build_configurations: "Release"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: "FluffyChat Share",
      profile_name: "match AppStore im.fluffychat.app.FluffyChat-Share",
      code_sign_identity: "Apple Distribution",
      build_configurations: "Release"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: "Notification Service Extension",
      profile_name: "match AppStore im.fluffychat.app.Notification-Service-Extension",
      code_sign_identity: "Apple Distribution",
      build_configurations: "Release"
    )
end

def prepare_flutter()
    sh("flutter", "pub", "add", "fcm_shared_isolate")
    sh("sed", "-i", "", "s,//<GOOGLE_SERVICES>,,g", "../../lib/utils/background_push.dart")
    sh("flutter", "clean")
    sh("flutter", "pub", "get")
    sh("flutter", "build", "ios", "--config-only", "--no-codesign", "--release")
end

platform :ios do
  desc "Push a new release candidate to TestFlight"
  lane :rc do
    app_store_connect_api_key(
      key_id: "DZ7AV6DHSV",
      issuer_id: "6297c3b0-c8cf-4c26-a447-cad744461fa8",
      key_content: ENV['APP_STORE_API_KEY'],
      in_house: false
    )
    setup_signing()
    prepare_flutter()
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: { manageAppVersionAndBuildNumber: false }
    )
    upload_to_testflight(
      distribute_external: true,
      groups: "Beta",
      changelog: "Please search for regressions and report them on: https://github.com/krille-chan/fluffychat/issues"
    )
  end

  desc "Releases to the AppStore"
  lane :release do
    app_store_connect_api_key(
      key_id: "DZ7AV6DHSV",
      issuer_id: "6297c3b0-c8cf-4c26-a447-cad744461fa8",
      key_content: ENV['APP_STORE_API_KEY'],
      in_house: false
    )
    setup_signing()
    prepare_flutter()
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: { manageAppVersionAndBuildNumber: false }
    )
    upload_to_testflight(
      distribute_external: true,
      groups: "Beta",
      changelog: "Please search for regressions and report them on: https://github.com/krille-chan/fluffychat/issues"
    )
    upload_to_app_store(
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_screenshots: true,
    )
  end
end
